# Скопируйте в .env и заполните.

LOCAL_USER_ID=local_user
# SECRET_KEY=  (необязательно; если пусто — генерируется при запуске)

# Домены, по которым внешний ИИ подключается к /mcp через nginx (через запятую)

# ---------- Вход ----------
# Локальный режим без входа (только для своей машины):
# AUTH_DISABLED=0
LOCAL_USER_ID=local_user
# Ключ сессий. Для продакшена задайте постоянный (32+ символов), иначе сессии сбрасываются при перезапуске:
# SECRET_KEY=
# Файл базы пользователей (по умолчанию auth.db рядом с run.py)
# AUTH_DB_PATH=
# В dev-режиме коды пишутся в лог вместо письма. В продакшене всегда 0:
AUTH_DEV_MODE=0
APP_NAME=AI-ассистент

# ---------- Почта ----------
# smtp — по SMTP (порты 465/587). Если провайдер их блокирует, используй unisender_go, resend или brevo.
MAIL_PROVIDER=smtp
# RESEND_API_KEY=
# BREVO_API_KEY=
# UNISENDER_GO_API_KEY=
# UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1

# ---------- Почта (SMTP) ----------
# Пример для любого провайдера с SMTP. Порт 587 — STARTTLS, порт 465 — SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.ru
SMTP_STARTTLS=1

# Домены для внешнего ИИ через nginx (через запятую)
MCP_PUBLIC_HOSTS=

# LLM (LM Studio) и генерация изображений (EasyDiffusion) задаются в GCN/config_ai.py
# Каталог данных памяти по умолчанию: ../ai_memory_v3 (рядом с папкой проекта)
# GENERATED_IMAGES_DIR=

# Сервер: nginx в Docker проксирует на SERVER_HOST:SERVER_PORT хоста.
# 127.0.0.1 достаточно для Docker Desktop (host.docker.internal доходит до loopback хоста).
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Окружение: development или production
# production включает cookie только по HTTPS — ставьте при доступе из интернета
FLASK_ENV=development
