# ===== LLM-бэкенд =====
# lmstudio  — как раньше: модель грузится в LM Studio (значение по умолчанию)
# llamacpp  — приложение само запускает llama-server и грузит GGUF из MODELS_DIR
LLM_BACKEND=lmstudio

# ---- только для LM Studio ----
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=local-model

# ---- только для llamacpp ----
# Папка с GGUF (сканируется рекурсивно)
MODELS_DIR=E:\models
# Путь к llama-server.exe из сборки llama.cpp с CUDA (свежая сборка, b5000+)
LLAMACPP_SERVER_BIN=C:\llama.cpp\llama-server.exe
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
# id модели по умолчанию = путь относительно MODELS_DIR с прямыми слэшами
LLAMACPP_DEFAULT_MODEL=
# поднимать модель по умолчанию при старте приложения
LLAMACPP_AUTOSTART=0
# сколько секунд ждать готовности (большие модели грузятся минуты)
LLAMACPP_STARTUP_TIMEOUT=300
# порядок карт CUDA как в nvidia-smi (3060 и 1660 SUPER не перепутать)
LLAMACPP_CUDA_DEVICE_ORDER=PCI_BUS_ID

# Значения по умолчанию при загрузке (для каждой модели их можно изменить в окне настроек)
LLAMACPP_CTX=8192
LLAMACPP_GPU_LAYERS=-1
LLAMACPP_FLASH_ATTN=1
LLAMACPP_KV_CACHE_TYPE=q8_0
LLAMACPP_THREADS=14
LLAMACPP_MAIN_GPU=0
# доли слоёв по картам, например 12,6 (пусто = авто)
LLAMACPP_TENSOR_SPLIT=
LLAMACPP_PARALLEL=1
# доп. аргументы llama-server одной строкой (если нужны)
LLAMACPP_EXTRA_ARGS=
LLAMACPP_LOG=llama_server.log
